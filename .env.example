# Supabase Credentials for Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ⚠️ DEVELOPMENT-ONLY auth bypass (see lib/dev-auth-bypass.ts). Active
# automatically whenever NODE_ENV !== "production"; set to 0 to disable it in
# development too. It never activates in a production build. A VALID
# SUPABASE_SERVICE_ROLE_KEY above is required for /admin to load real data
# without logging in.
NEXT_PUBLIC_DEV_AUTH_BYPASS=1
