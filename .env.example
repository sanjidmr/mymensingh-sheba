# Supabase Credentials for Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only Brevo transactional email alerts. EMAIL_FROM must be a verified
# sender in Brevo; ADMIN_NOTIFICATION_EMAIL should be the administrator's Gmail.
BREVO_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
EMAIL_FROM=""
APP_BASE_URL="https://mymensinghsheba.com"

# ⚠️ PRIVATE, local-development-only auth bypass (see lib/dev-auth-bypass.ts).
# Leave unset. It is accepted only by `next dev` outside hosted Vercel builds.
# Never use it with production/shared data or expose the service-role key.
# DEV_AUTH_BYPASS=1
