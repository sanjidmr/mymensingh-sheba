# ⚠️ PRIVATE, local-development-only auth bypass (see lib/dev-auth-bypass.ts).
# Leave unset. It is accepted only by `next dev` outside hosted Vercel builds.
# Never use it with production/shared data or expose the service-role key.
# DEV_AUTH_BYPASS=1
